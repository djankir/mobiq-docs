  "leistungsbeschreibung": {
    "id": "01MOBIQ004896DOC21",
    "name": "Leistungsbeschreibung_MOBIQ_ERP_2026.docx",
    "kind": "docx",
    "path": "Vertrieb/Leistungsbeschreibung_MOBIQ_ERP_2026.docx",
    "docType": "leistungsbeschreibung",
    "title": "Leistungsbeschreibung MOBIQ ERP 2026",
    "blocks": [
      {
        "h1": "Leistungsbeschreibung MOBIQ ERP"
      },
      {
        "p": "Anlage zum Software-Pflegevertrag · Stand 2026"
      },
      {
        "h2": "1 Kaufvertrag und Auftrag"
      },
      {
        "bullets": [
          "Kaufvertrag mit Positionen, Anzahlung und Finanzkauf",
          "Lieferung: Komplettlieferung je Kaufvertrag mit Wunschtermin (Kalenderwoche)",
          "Montageplanung mit Montage-App"
        ]
      },
      {
        "h2": "2 Auslieferung"
      },
      {
        "bullets": [
          "Grafische Tourenplanung mit Karte",
          "Avisierung per SMS oder E-Mail, standardmäßig 48 Stunden vor der Lieferung",
          "Fahrer-App mit Lieferschein und Restzahlung"
        ]
      },
      {
        "h2": "3 Kasse"
      },
      {
        "bullets": [
          "Filialkasse mit Kartenterminal",
          "Gutscheine: Verkauf und vollständige Einlösung",
          "Tagesabschluss je Filiale"
        ]
      },
      {
        "h2": "4 Finanzbuchhaltung"
      },
      {
        "bullets": [
          "Nächtliche Übergabe von Rechnungen, Gutschriften und Anzahlungen",
          "Belegarten RE, GS, AZ"
        ]
      }
    ],
    "sheets": null,
    "pages": null
  },
