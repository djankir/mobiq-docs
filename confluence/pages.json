      "body": {
        "storage": {
          "representation": "storage",
          "value": "<p>Vom Angebot bis zur Auslieferung: alles rund um den Kaufvertrag.</p><ac:structured-macro ac:name=\"children\" ac:schema-version=\"1\" ac:macro-id=\"a1b2c3d4-0003-4e5f-9a0b-000001023757\"><ac:parameter ac:name=\"all\">true</ac:parameter></ac:structured-macro>"
        }
      },
